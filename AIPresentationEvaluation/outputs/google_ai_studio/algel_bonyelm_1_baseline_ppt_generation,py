#Mivel közvetlen fájlküldés a chat felületén nem lehetséges, egy speciális Python szkriptet készítettem el, amely a megadott elvárásoknak megfelelően generálja a .pptx fájlt.
# Először telepítsd a könyvtárat: pip install python-pptx
from pptx import Presentation
from pptx.util import Inches, Pt
from pptx.enum.text import PP_ALIGN

def create_presentation():
    prs = Presentation()

    # Segédfunkció a slide létrehozásához
    def add_slide(title_text, bullet_points, definition=None, notes=None):
        slide_layout = prs.slide_layouts[1] # Title and Content layout
        slide = prs.slides.add_slide(slide_layout)
        
        # Cím beállítása
        title = slide.shapes.title
        title.text = title_text
        
        # Tartalom (Bullet pontok)
        body_shape = slide.placeholders[1]
        tf = body_shape.text_frame
        tf.text = bullet_points[0] if bullet_points else ""
        for bp in bullet_points[1:]:
            p = tf.add_paragraph()
            p.text = bp
            p.level = 0

        # Definíció kiemelése (ha van)
        if definition:
            left = Inches(0.5)
            top = Inches(4.5)
            width = Inches(9)
            height = Inches(2)
            txBox = slide.shapes.add_textbox(left, top, width, height)
            tf_def = txBox.text_frame
            p = tf_def.add_paragraph()
            p.text = f"KÉPLET / DEFINÍCIÓ: {definition}"
            p.font.bold = True
            p.font.size = Pt(24)

        # Előadói jegyzetek
        if notes:
            notes_slide = slide.notes_slide
            text_frame = notes_slide.notes_text_frame
            text_frame.text = notes

    # --- SLIDE ADATOK ---
